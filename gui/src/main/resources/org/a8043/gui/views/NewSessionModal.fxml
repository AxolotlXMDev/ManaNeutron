<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.a8043.gui.views.NewSessionModal">
    <children>
        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Label text="%session.name"/>
                <Label text="%session.workDir" GridPane.rowIndex="1"/>
                <Label text="%session.model" GridPane.rowIndex="2"/>
                <ComboBox fx:id="modelBox" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <TextField fx:id="workDirField" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <TextField fx:id="nameField" prefWidth="200.0" GridPane.columnIndex="1"/>
                <Label text="%session.effort" GridPane.rowIndex="3"/>
                <ComboBox fx:id="effortBox" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </children>
        </GridPane>
        <Separator/>
        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button mnemonicParsing="false" onAction="#create" text="%main.newSession"/>
            </children>
        </HBox>
    </children>
</VBox>
