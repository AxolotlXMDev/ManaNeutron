<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.*?>
<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.a8043.gui.views.SessionTab">
    <children>
        <ListView fx:id="contentList" VBox.vgrow="ALWAYS"/>
        <VBox fx:id="workStatusBox"/>
        <StackPane fx:id="inputPane">
            <children>
                <HBox spacing="2.0">
                    <children>
                        <TextArea fx:id="textArea" prefHeight="40.0" HBox.hgrow="ALWAYS"/>
                        <Button maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                                mnemonicParsing="false" onAction="#send" prefHeight="40.0" prefWidth="40.0" text="↑"/>
                    </children>
                </HBox>
            </children>
        </StackPane>
        <HBox fx:id="statusLine"/>
    </children>
</VBox>
